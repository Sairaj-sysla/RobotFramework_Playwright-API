# Copy to .env (git-ignored) and replace the placeholder values.
# Variables already set in the process environment (e.g. CI secrets) take precedence over .env.

# --- Environment -----------------------------------------------------------
TEST_ENV=local
# UI and API of the application under test (defaults match the bundled demo app)
BASE_URL=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:3000/api

# --- Secrets (never commit real values) -------------------------------------
# Bearer token for the API; at least 16 characters. Read by the TypeScript
# remote server only - it is never passed through Robot Framework.
API_TOKEN=replace-with-a-random-token-of-16-plus-chars
# UI login account
APP_USERNAME=qa.user
APP_PASSWORD=replace-with-a-password

# --- Browser ------------------------------------------------------------------
BROWSER=chromium            # chromium | firefox | webkit
HEADLESS=true
BROWSER_TIMEOUT_MS=10000    # element actions and assertions
NAVIGATION_TIMEOUT_MS=15000 # page loads
BROWSER_TRACING=false       # true = Playwright trace zip per context in results/browser/traces

# --- API ------------------------------------------------------------------------
API_TIMEOUT_MS=10000
API_RETRIES=1               # extra attempts for GET/HEAD/OPTIONS on network errors or 502/503/504

# --- Framework ------------------------------------------------------------------
LOG_LEVEL=info              # debug | info | warn | error (framework process logs)
RESULTS_DIR=results
REMOTE_HOST=127.0.0.1       # keep on loopback unless remote access is required
REMOTE_PORT=8270

# --- Bundled demo application -------------------------------------------------
START_DEMO_APP=true         # false when testing an externally hosted application
DEMO_APP_PORT=3000
DEMO_UI_DELAY_MS=300        # users table renders after this delay (exercises waits)
