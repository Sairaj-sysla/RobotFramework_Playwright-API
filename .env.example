# Copy to .env (git-ignored) and replace the placeholder values.
# Variables already set in the process environment (e.g. CI secrets) take precedence over .env.
# For a second environment, create .env.<name> (e.g. .env.staging) and run with --env <name>;
# its values win over .env.

# --- Environment -----------------------------------------------------------
TEST_ENV=local

# --- Application under test ------------------------------------------------
BASE_URL=https://.example.invalid

# --- OrangeHRM suite (tests/web/orangehrm_login.robot) ---------------------
# Login page (getEasyURL()); when empty, BASE_URL is used instead.
EASY_URL=https://opensource-demo.orangehrmlive.com/web/index.php/auth/login
# Excel workbook with the 'LoginTestData' sheet (TestCaseID | Username | Password); relative to the
# project root or absolute. The credentials come from this file, not from APP_USERNAME/APP_PASSWORD.
ORANGE_LOGIN_WORKBOOK=../ABM-India/testdata/excelDataFiles/Sample_TestData.xlsx

# --- ProjectBase login account (never commit real values) ------------------
APP_USERNAME=replace-with-the-test-account-email
APP_PASSWORD=replace-with-the-test-account-password

# --- Browser ------------------------------------------------------------------
BROWSER=chromium            # chromium | firefox | webkit
# Run an installed system browser instead of Playwright's Chromium (requires BROWSER=chromium):
# BROWSER_CHANNEL=msedge    # chrome | chrome-beta | msedge | msedge-beta | msedge-dev
# Where Playwright browsers are installed and looked up. Default: inside the venv's Browser
# package. Set a short path on Windows if the project lives in a deep folder (260-char limit),
# and set it the same way before running 'rfbrowser install'.
# PLAYWRIGHT_BROWSERS_PATH=C:\pw-browsers
HEADLESS=true               # false = watch the browser
BROWSER_TIMEOUT_MS=10000    # element waits and actions
NAVIGATION_TIMEOUT_MS=30000 # page loads and the post-login header wait (LoginPage's Global_Timeout)
BROWSER_TRACING=false       # true = Playwright trace zip per test in results/browser/traces (password redacted after npm runs)

# --- Framework ------------------------------------------------------------------
LOG_LEVEL=info              # debug | info | warn | error (orchestrator messages)
RESULTS_DIR=results
