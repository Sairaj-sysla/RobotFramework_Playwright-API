# Optional ProjectBase environment profile. Copy to .env.projectbase (git-ignored) and fill in.
# Used by: npm test -- --env projectbase   (or: node dist/scripts/runTests.js --env projectbase ...)
# Values here win over .env; variables already set in the process environment (e.g. CI secrets)
# win over both. Most setups only need .env (see .env.example); use a profile like this one to
# keep a second ProjectBase environment (e.g. staging) next to it.

TEST_ENV=projectbase

# --- Application under test -------------------------------------------------
BASE_URL=https://projectbase.example.invalid

# --- Login account (never commit real values) ------------------------------
APP_USERNAME=replace-with-the-test-account-email
APP_PASSWORD=replace-with-the-test-account-password

# --- Browser -----------------------------------------------------------------
BROWSER=chromium
HEADLESS=true
BROWSER_TIMEOUT_MS=10000
# Page loads and the post-login header wait (LoginPage used Global_Timeout for these)
NAVIGATION_TIMEOUT_MS=30000
