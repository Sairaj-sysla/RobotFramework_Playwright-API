{
  "name": "robot-playwright-api-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Robot Framework + Browser (Playwright) UI automation for ProjectBase, with a TypeScript test orchestrator",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preenv:check": "npm run build",
    "env:check": "node dist/scripts/checkEnv.js",
    "pretest:unit": "npm run build",
    "test:unit": "node --test \"dist/test/unit/*.test.js\"",
    "pretest": "npm run build",
    "test": "node dist/scripts/runTests.js",
    "pretest:web": "npm run build",
    "test:web": "node dist/scripts/runTests.js --include web",
    "pretest:projectbase": "npm run build",
    "test:projectbase": "node dist/scripts/runTests.js --include projectbase",
    "pretest:orangehrm": "npm run build",
    "test:orangehrm": "node dist/scripts/runTests.js --include orangehrm",
    "prerobot": "npm run build",
    "robot": "node dist/scripts/runTests.js",
    "pretraces:redact": "npm run build",
    "traces:redact": "node dist/scripts/redactTraces.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  }
}
